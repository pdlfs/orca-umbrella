+/* -------------------------------------------------------------------------
+ * ORCA: set QoSClass/TOS (0..255) on the rdma_cm_id BEFORE route resolution.
+ * This value is carried in the PathRecord query; OpenSM QoS policy can match
+ * it and return a PathRecord with the desired SL. If unset, default is 0.
+ * ------------------------------------------------------------------------- */
+static void orca_set_qos_tos(struct rdma_cm_id *id)
+{
+	const char *env = getenv("ORCA_OFI_TOS");
+	if (!env || !id)
+		return;
+
+	char *end = NULL;
+	unsigned long v = strtoul(env, &end, 0);
+	if (end == env)  /* not a number */
+		return;
+
+	uint8_t tos = (uint8_t)(v & 0xFF);
+	if (rdma_set_option(id, RDMA_OPTION_ID, RDMA_OPTION_ID_TOS,
+			    &tos, sizeof(tos))) {
+		FI_WARN(&vrb_prov, FI_LOG_EP_CTRL,
+			"ORCA: rdma_set_option(TOS=%u) failed: %s\n",
+			tos, strerror(errno));
+	} else {
+		FI_INFO(&vrb_prov, FI_LOG_EP_CTRL,
+			"ORCA: set QoSClass/TOS=%u on CM ID\n", tos);
+	}
+}
